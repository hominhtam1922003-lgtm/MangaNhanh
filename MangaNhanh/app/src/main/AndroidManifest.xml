private val ChipActive = Color(0xFF2E323B)

private const val USER_AGENT = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"

enum class MangaSource(val displayName: String, val baseUrl: String) {
    NETTRUYEN("NetTruyen", "https://nettruyen.gg"),
    TRUYENQQ("TruyenQQ", "https://truyenqqko.com")
}

data class MangaItem(
    val title: String,
    val detailUrl: String,
    val coverUrl: String,
    val latestChap: String,
    val source: MangaSource
)

data class ChapterItem(
    val title: String,
    val chapterUrl: String,
    val source: MangaSource
)

class MainActivity : ComponentActivity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContent { MangaApp() }
    }
}

object ScraperManager {
    suspend fun fetchMangaList(source: MangaSource, keyword: String = ""): List<MangaItem> = withContext(Dispatchers.IO) {
        val list = mutableListOf<MangaItem>()
        try {
            when (source) {
                MangaSource.NETTRUYEN -> {
                    val url = if (keyword.isBlank()) {
                        "${source.baseUrl}/trang-chu"
                    } else {
                        "${source.baseUrl}/tim-truyen?keyword=" + URLEncoder.encode(keyword, "UTF-8")
                    }
                    val doc = Jsoup.connect(url)
                        .userAgent(USER_AGENT)
                        .referrer(source.baseUrl)
                        .timeout(15000)
                        .get()

                    val items = doc.select(".items .item, .list-items .item, div.item")
                    for (el in items) {
                        val titleEl = el.select(".title a, h3 a, figcaption a").first() ?: continue
                        val title = titleEl.text().trim()
                        var detailUrl = titleEl.attr("href")
                        if (!detailUrl.startsWith("http")) detailUrl = source.baseUrl + if (detailUrl.startsWith("/")) detailUrl else "/$detailUrl"

                        val imgEl = el.select("img").first()
                        var cover = imgEl?.attr("data-original")?.takeIf { it.isNotBlank() }
                            ?: imgEl?.attr("data-src")?.takeIf { it.isNotBlank() }
                            ?: imgEl?.attr("src") ?: ""
                        if (cover.startsWith("//")) cover = "https:$cover"
                        else if (!cover.startsWith("http") && cover.isNotBlank()) cover = source.baseUrl + if (cover.startsWith("/")) cover else "/$cover"

                        val chap = el.select(".chapter a, .comic-item-chapter a").first()?.text()?.trim() ?: "Mới cập nhật"
                        if (title.isNotBlank()) list.add(MangaItem(title, detailUrl, cover, chap, source))
                    }
                }
                MangaSource.TRUYENQQ -> {
                    val url = if (keyword.isBlank()) {
                        "${source.baseUrl}/truyen-moi-cap-nhat.html"
                    } else {
                        "${source.baseUrl}/tim-kiem/trang-1.html?q=" + URLEncoder.encode(keyword, "UTF-8")
                    }
                    val doc = Jsoup.connect(url)
                        .userAgent(USER_AGENT)
                        .referrer(source.baseUrl)
                        .timeout(15000)
                        .get()

                    val items = doc.select("ul.list_grid li, ul.grid li, .list-stories li")
                    for (el in items) {
                        val titleEl = el.select(".book_avatar a, .book_name a, h3 a").first() ?: continue
                        val title = titleEl.attr("title").takeIf { it.isNotBlank() } ?: titleEl.text().trim()
                        var detailUrl = titleEl.attr("href")
                        if (!detailUrl.startsWith("http")) detailUrl = source.baseUrl + if (detailUrl.startsWith("/")) detailUrl else "/$detailUrl"

                        val imgEl = el.select("img").first()
                        var cover = imgEl?.attr("src")?.takeIf { it.isNotBlank() }
                            ?: imgEl?.attr("data-src") ?: ""
                        if (cover.startsWith("//")) cover = "https:$cover"
                        else if (!cover.startsWith("http") && cover.isNotBlank()) cover = source.baseUrl + if (cover.startsWith("/")) cover else "/$cover"

                        val chap = el.select(".last_chapter a, .chapter a").first()?.text()?.trim() ?: "Mới cập nhật"
                        if (title.isNotBlank()) list.add(MangaItem(title, detailUrl, cover, chap, source))
                    }
                }
            }
        } catch (_: Exception) {}
        list
    }

    suspend fun fetchChapters(source: MangaSource, detailUrl: String): Pair<String, List<ChapterItem>> = withContext(Dispatchers.IO) {
        val chapters = mutableListOf<ChapterItem>()
        var description = "Đang cập nhật tóm tắt..."
        try {
            val doc = Jsoup.connect(detailUrl)
                .userAgent(USER_AGENT)
                .referrer(source.baseUrl)
                .timeout(15000)
                .get()

            when (source) {
                MangaSource.NETTRUYEN -> {
                    val descEl = doc.select(".detail-content p, .comic-description, .detail-summary").first()
                    if (descEl != null && descEl.text().isNotBlank()) description = descEl.text().trim()

                    val rows = doc.select(".list-chapter li, #nt_listchapter li, .chapter-list div.row")
                    for (row in rows) {
                        val a = row.select("a").first() ?: continue
                        val t = a.text().trim()
                        var url = a.attr("href")
                        if (!url.startsWith("http")) url = source.baseUrl + if (url.startsWith("/")) url else "/$url"
                        if (t.isNotBlank()) chapters.add(ChapterItem(t, url, source))
                    }
                }
                MangaSource.TRUYENQQ -> {
                    val descEl = doc.select(".story-detail-info, .story-detail-summary, .detail-content").first()
                    if (descEl != null && descEl.text().isNotBlank()) description = descEl.text().trim()

                    val rows = doc.select(".works-chapter-list .works-chapter-item a, .list_chapter a")
                    for (a in rows) {
                        val t = a.text().trim()
                        var url = a.attr("href")
                        if (!url.startsWith("http")) url = source.baseUrl + if (url.startsWith("/")) url else "/$url"
                        if (t.isNotBlank()) chapters.add(ChapterItem(t, url, source))
                    }
                }
            }
        } catch (_: Exception) {}
        Pair(description, chapters)
    }

    suspend fun fetchPages(source: MangaSource, chapterUrl: String): List<String> = withContext(Dispatchers.IO) {
        val pages = mutableListOf<String>()
        try {
            val doc = Jsoup.connect(chapterUrl)
                .userAgent(USER_AGENT)
                .referrer(source.baseUrl)
                .timeout(15000)
                .get()

            val elements = doc.select(".page-chapter img, .reading-detail img, .chapter-content img, .story-see-content img")
            for (img in elements) {
                var src = img.attr("data-original").takeIf { it.isNotBlank() }
                    ?: img.attr("data-src").takeIf { it.isNotBlank() }
                    ?: img.attr("data-cdn").takeIf { it.isNotBlank() }
                    ?: img.attr("src") ?: ""

                if (src.startsWith("//")) src = "https:$src"
                else if (!src.startsWith("http") && src.isNotBlank()) src = source.baseUrl + if (src.startsWith("/")) src else "/$src"

                if (src.isNotBlank() && !src.contains("icon") && !src.contains("banner") && !src.contains("logo")) {
                    pages.add(src)
                }
            }
        } catch (_: Exception) {}
        pages
    }
}

fun rememberRefererImageLoader(context: Context, referer: String): ImageLoader {
    val client = OkHttpClient.Builder()
        .addInterceptor { chain ->
            val req = chain.request().newBuilder()
                .header("User-Agent", USER_AGENT)
                .header("Referer", referer)
                .build()
            chain.proceed(req)
        }
        .build()
    return ImageLoader.Builder(context).okHttpClient(client).build()
}

@Composable
fun MangaApp() {
    var selectedManga by remember { mutableStateOf<MangaItem?>(null) }
    var readingChapter by remember { mutableStateOf<ChapterItem?>(null) }
    var query by remember { mutableStateOf("") }
    var currentSource by remember { mutableStateOf(MangaSource.NETTRUYEN) }
    var tab by remember { mutableStateOf(0) }
    var favorites by remember { mutableStateOf(setOf<String>()) }

    MaterialTheme(colorScheme = darkColorScheme(background = Bg, surface = Surface, primary = Accent)) {
        Surface(Modifier.fillMaxSize(), color = Bg) {
            when {
                readingChapter != null && selectedManga != null -> {
                    ReaderScreen(
                        manga = selectedManga!!,
                        chapter = readingChapter!!,
                        onBack = { readingChapter = null }
                    )
                }
                selectedManga != null -> {
                    DetailScreen(
                        manga = selectedManga!!,
                        favorite = favorites.contains(selectedManga!!.detailUrl),
                        onBack = { selectedManga = null },
                        onFavorite = {
                            favorites = if (favorites.contains(selectedManga!!.detailUrl)) {
                                favorites - selectedManga!!.detailUrl
                            } else {
                                favorites + selectedManga!!.detailUrl
                            }
                        },
                        onRead = { ch -> readingChapter = ch }
                    )
                }
                else -> {
                    HomeScreen(
                        source = currentSource,
                        onSourceChange = { currentSource = it },
                        query = query,
                        onQuery = { query = it },
                        tab = tab,
                        onTab = { tab = it },
                        favorites = favorites,
                        onOpen = { selectedManga = it }
                    )
                }
            }
        }
    }
}

@Composable
fun HomeScreen(
    source: MangaSource,
    onSourceChange: (MangaSource) -> Unit,
    query: String,
    onQuery: (String) -> Unit,
    tab: Int,
    onTab: (Int) -> Unit,
    favorites: Set<String>,
    onOpen: (MangaItem) -> Unit
) {
    val context = LocalContext.current
    val imageLoader = remember(source) { rememberRefererImageLoader(context, source.baseUrl) }
    var mangaList by remember { mutableStateOf<List<MangaItem>>(emptyList()) }
    var loading by remember { mutableStateOf(true) }

    LaunchedEffect(source, query) {
        loading = true
        mangaList = ScraperManager.fetchMangaList(source, query)
        loading = false
    }

    val displayList = mangaList.filter { tab != 1 || favorites.contains(it.detailUrl) }

    Column(Modifier.fillMaxSize().statusBarsPadding()) {
        Row(Modifier.fillMaxWidth().padding(horizontal = 20.dp, vertical = 14.dp), verticalAlignment = Alignment.CenterVertically) {
            Column(Modifier.weight(1f)) {
                Text("MANGA NHANH", fontSize = 20.sp, fontWeight = FontWeight.Black, color = Accent, letterSpacing = 1.2.sp)
                Text("Nguồn: ${source.displayName}", fontSize = 12.sp, color = Muted)
            }
        }

        OutlinedTextField(
            value = query,
            onValueChange = onQuery,
            modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp),
            placeholder = { Text("Tìm truyện trên ${source.displayName}…", color = Muted) },
            leadingIcon = { Icon(Icons.Default.Search, null, tint = Muted) },
            singleLine = true,
            shape = RoundedCornerShape(14.dp),
            colors = OutlinedTextFieldDefaults.colors(
                focusedBorderColor = Color(0xFF555963),
                unfocusedBorderColor = Color(0xFF303239),
                focusedTextColor = Accent,
                unfocusedTextColor = Accent
            )
        )

        Row(
            Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 10.dp),
            horizontalArrangement = Arrangement.spacedBy(8.dp)
        ) {
            MangaSource.values().forEach { s ->
                val isSelected = s == source
                Box(
                    modifier = Modifier
                        .clip(RoundedCornerShape(10.dp))
                        .background(if (isSelected) ChipActive else Color.Transparent)
                        .clickable { onSourceChange(s) }
                        .padding(horizontal = 14.dp, vertical = 6.dp)
                ) {
                    Text(
                        s.displayName,
                        color = if (isSelected) Accent else Muted,
                        fontWeight = if (isSelected) FontWeight.Bold else FontWeight.Normal,
                        fontSize = 13.sp
                    )
                }
            }
        }

        Row(Modifier.padding(horizontal = 20.dp, vertical = 8.dp), horizontalArrangement = Arrangement.spacedBy(20.dp)) {
            Text("Mới cập nhật", color = if (tab == 0) Accent else Muted, fontWeight = FontWeight.SemiBold, modifier = Modifier.clickable { onTab(0) })
            Text("Yêu thích", color = if (tab == 1) Accent else Muted, fontWeight = FontWeight.SemiBold, modifier = Modifier.clickable { onTab(1) })
        }

        if (loading) {
            Box(Modifier.fillMaxWidth().weight(1f), contentAlignment = Alignment.Center) {
                CircularProgressIndicator(color = Accent)
            }
        } else {
            LazyColumn(
                contentPadding = PaddingValues(start = 16.dp, end = 16.dp, bottom = 24.dp),
                verticalArrangement = Arrangement.spacedBy(10.dp),
                modifier = Modifier.weight(1f)
            ) {
                items(displayList) { manga ->
                    Row(
                        Modifier.fillMaxWidth().clip(RoundedCornerShape(16.dp)).background(Surface).clickable { onOpen(manga) }.padding(12.dp),
                        verticalAlignment = Alignment.CenterVertically
                    ) {
                        AsyncImage(
                            model = ImageRequest.Builder(context).data(manga.coverUrl).crossfade(true).build(),
                            imageLoader = imageLoader,
                            contentDescription = manga.title,
                            modifier = Modifier.size(width = 76.dp, height = 100.dp).clip(RoundedCornerShape(10.dp)),
                            contentScale = ContentScale.Crop
                        )

                        Column(Modifier.weight(1f).padding(start = 14.dp)) {
                            Text(manga.title, color = Accent, fontWeight = FontWeight.Bold, fontSize = 15.sp, maxLines = 2)
                            Spacer(Modifier.height(6.dp))
                            Text(manga.latestChap, color = Muted, fontSize = 12.sp)
                        }
                    }
                }
                if (displayList.isEmpty()) {
                    item { Text("Không tìm thấy truyện hoặc website tải chậm.", color = Muted, modifier = Modifier.padding(20.dp)) }
                }
            }
        }

        Row(Modifier.fillMaxWidth().navigationBarsPadding().background(Color(0xFF15161A)).padding(vertical = 12.dp), horizontalArrangement = Arrangement.Center) {
            Icon(Icons.Default.Home, null, tint = Accent)
            Text("   Trang chủ", color = Muted, fontSize = 12.sp)
        }
    }
}

